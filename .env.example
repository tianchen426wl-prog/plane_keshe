# ============================================================================
# 航空售票管理系统 · 本地环境配置示例
# ============================================================================
# 1. 在项目根目录执行 ./scripts/setup-env.ps1（生成 .env 和随机 JWT 密钥）
#    也可以手动 Copy-Item .env.example .env，再自行生成 JWT_SECRET。
# 2. 修改 .env 中的 DB_USERNAME、DB_PASSWORD；按需修改工具路径、端口及 AI 配置。
# 3. ./start_backend.ps1 自动加载 .env；已有终端环境变量优先，命令行参数优先于端口/库名配置。
# 4. .env 仅保存在本机，提交仓库使用此示例文件。
# 支持 KEY=value、单/双引号、注释、export KEY=value；不会执行命令或展开 $变量。
# 密码含空格或 # 时请用引号，单引号内部的单引号写成 \'，反斜杠写成 \\。

# ======================== 【运行工具】 ========================
# Java 项目使用 JDK + Maven，无需 Python venv。
# 已加入 PATH 可不填写；路径按自己的安装位置修改后取消注释。
# JAVA_HOME='C:\Program Files\Java\jdk-17.0.5'
# MAVEN_HOME='C:\tools\apache-maven-3.9.6'

# ======================== 【服务与端口】 ========================
SERVER_PORT=18080
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:18081,http://127.0.0.1:18082
# 若更改后端 SERVER_PORT，请同步修改前端 BACKEND_URL。
BACKEND_URL=http://127.0.0.1:18080
PORTAL_PORT=18081
ADMIN_PORT=18082

# ======================== 【数据库 - MySQL】 ========================
# MySQL 8.0.16+，请预先安装并启动 MySQL 服务。
# 用户名/密码为 MySQL 连接凭据，不是门户或管理后台的登录账号。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=air_ticket
DB_USERNAME=root
DB_PASSWORD='replace_with_local_password'
# 首次启动自动建库、建表与迁移，账号需具备相应权限。
DB_INITIALIZE=true
DB_CREATE_IF_MISSING=true

# ======================== 【认证密钥】 ========================
# setup-env.ps1 自动替换此值；固定保存，不要每次启动重新生成。
JWT_SECRET=replace_with_a_random_base64_secret_at_least_32_bytes

# ======================== 【每日航班】 ========================
FLIGHT_GENERATION_ENABLED=true

# ======================== 【DeepSeek 智能规划（可选）】 ========================
# 不使用智能规划可保持 false；普通查询、购票不依赖外部 AI。
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
